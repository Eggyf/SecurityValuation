# Secretos de la aplicación (AGENTS.md §11 y §13).
# Copia este archivo a `.env` (que está en .gitignore) y rellena los valores.

# Obligatoria para cualquier acceso a SEC EDGAR (data_sources/, v2).
# Formato exigido por la SEC: "Nombre Apellido email@ejemplo.com"
SEC_USER_AGENT=

# Opcional: tasa libre de riesgo desde FRED (serie DGS10), alternativa a Treasury.
FRED_API_KEY=

# Opcional: proveedor de datos de mercado (Financial Modeling Prep, Alpha Vantage,
# Polygon, Tiingo...). Indica también qué proveedor usa cada clave.
MARKET_DATA_API_KEY=

# Activa las descargas opt-in de data_sources/ (v2). La app es 100 % offline sin esto.
# DCF_ONLINE=1
